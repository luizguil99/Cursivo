# Application
VITE_APP_NAME=Cursivo
VITE_APP_URL=http://localhost:5173

# OpenAI Configuration
VITE_OPENAI_API_KEY=your-openai-api-key-here
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_MAX_TOKENS=2000

# MinIO Storage Configuration
VITE_MINIO_ENDPOINT=your-minio-endpoint
VITE_MINIO_PORT=443
VITE_MINIO_USE_SSL=true
VITE_MINIO_ACCESS_KEY=your-minio-access-key
VITE_MINIO_SECRET_KEY=your-minio-secret-key
VITE_MINIO_BUCKET=your-bucket-name
VITE_MINIO_REGION=us-east-1

# Storage Paths
VITE_STORAGE_PATH_CHAT_IMAGES=chat-images

# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_SERVICE_KEY=your-supabase-service-key
