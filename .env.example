# Application
VITE_APP_NAME=Cursivo
VITE_APP_URL=http://localhost:5173

# OpenAI Configuration
VITE_OPENAI_API_KEY=your-api-key-here
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_MAX_TOKENS=2000

# MinIO Storage Configuration
VITE_MINIO_ENDPOINT=your-minio-endpoint
VITE_MINIO_PORT=443
VITE_MINIO_USE_SSL=true
VITE_MINIO_ACCESS_KEY=your-access-key
VITE_MINIO_SECRET_KEY=your-secret-key
VITE_MINIO_BUCKET=your-bucket
VITE_MINIO_REGION=us-east-1

# Storage Paths
VITE_STORAGE_PATH_CHAT_IMAGES=chat-images
